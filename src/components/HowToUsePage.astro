---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { getLocalizedPath, type LocaleCode } from '../i18n/config';
import { getTranslations } from '../i18n/translations';
import { buildBreadcrumbSchema, buildHowToSchema } from '../utils/schemas';

interface Props {
  lang: LocaleCode;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const schemas = [
  buildBreadcrumbSchema(lang, 'how-to-use', t),
  buildHowToSchema(lang, t),
];
---

<BaseLayout
  lang={lang}
  page="how-to-use"
  title={t.howToUse.title}
  description={t.howToUse.description}
  ogImageAlt={t.howToUse.ogImageAlt}
  t={t}
  schemas={schemas}
>
  <div class="mx-auto max-w-4xl">
    <Breadcrumbs
      lang={lang}
      homeLabel={t.nav.home}
      currentLabel={t.howToUse.breadcrumbCurrent}
      navAriaLabel={t.nav.breadcrumbLabel}
    />

    <header class="mb-9">
      <h1 class="text-2xl sm:text-3xl lg:text-[2.3rem] font-bold tracking-[-0.025em] text-ink-primary leading-tight">
        {t.howToUse.h1}
      </h1>
      <p class="mt-3 text-sm sm:text-base leading-relaxed text-ink-secondary max-w-3xl">
        {t.howToUse.intro}
      </p>
    </header>

    <section aria-labelledby="steps-heading" class="space-y-4">
      <h2 id="steps-heading" class="text-lg sm:text-xl font-bold tracking-[-0.015em] text-ink-primary">
        {t.howToUse.stepsHeading}
      </h2>

      <ol class="rounded-2xl border border-line/90 bg-card shadow-soft divide-y divide-line/75 overflow-hidden">
        {t.howToUse.steps.map((step, index) => (
          <li id={`step-${index + 1}`} class="p-5 sm:p-6">
            <div class="flex items-start gap-4">
              <span
                aria-hidden="true"
                class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-accent-secondary/45 dark:bg-accent/25 font-mono text-sm font-bold text-ink-primary"
              >
                0{index + 1}
              </span>
              <div class="space-y-2 min-w-0">
                <h3 class="text-base sm:text-lg font-bold text-ink-primary">
                  {step.title}
                </h3>
                <p class="text-sm sm:text-[15px] leading-relaxed text-ink-secondary">
                  {step.description}
                </p>
                {step.tip && (
                  <p class="rounded-xl bg-subtle/55 px-3.5 py-2.5 text-xs sm:text-sm font-medium text-ink-primary">
                    {step.tip}
                  </p>
                )}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="workflows-heading" class="mt-12 space-y-4">
      <h2 id="workflows-heading" class="text-lg sm:text-xl font-bold tracking-[-0.015em] text-ink-primary">
        {t.howToUse.workflowsHeading}
      </h2>

      <div class="grid gap-4 md:grid-cols-3">
        {t.howToUse.workflows.map((wf) => (
          <article class="rounded-2xl border border-line/85 bg-card p-5 shadow-soft flex flex-col">
            <h3 class="text-[15px] font-bold text-ink-primary leading-snug">
              {wf.title}
            </h3>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-secondary">
              {wf.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-12 rounded-2xl border border-line/85 bg-subtle/50 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-5">
      <div class="text-center sm:text-left">
        <h2 class="text-xl font-bold text-ink-primary">
          {t.howToUse.ctaTitle}
        </h2>
        <p class="mt-1 text-sm text-ink-secondary">
          {t.howToUse.ctaDescription}
        </p>
      </div>
      <a
        href={getLocalizedPath(lang, 'home')}
        class="btn-primary inline-flex min-h-[46px] shrink-0 items-center justify-center gap-2 rounded-xl px-6 py-2.5 text-sm font-semibold"
      >
        <span>{t.howToUse.ctaButton}</span>
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </section>
  </div>
</BaseLayout>
