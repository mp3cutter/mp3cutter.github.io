---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { DEVELOPER_EMAIL, type LocaleCode } from '../i18n/config';
import { getTranslations } from '../i18n/translations';
import { buildBreadcrumbSchema, buildPersonSchema } from '../utils/schemas';

interface Props {
  lang: LocaleCode;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const schemas = [
  buildBreadcrumbSchema(lang, 'hire-me', t),
  buildPersonSchema(lang, t),
];
---

<BaseLayout
  lang={lang}
  page="hire-me"
  title={t.hireMe.title}
  description={t.hireMe.description}
  ogImageAlt={t.hireMe.ogImageAlt}
  t={t}
  schemas={schemas}
>
  <div class="mx-auto max-w-4xl">
    <Breadcrumbs
      lang={lang}
      homeLabel={t.nav.home}
      currentLabel={t.hireMe.breadcrumbCurrent}
      navAriaLabel={t.nav.breadcrumbLabel}
    />

    <section class="rounded-2xl border border-line/90 bg-card shadow-studio overflow-hidden">
      <div class="p-6 sm:p-9">
        <div class="inline-flex items-center gap-2 rounded-full border border-line bg-page/80 px-3.5 py-1 mb-4">
          <span class="h-2 w-2 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse-soft" aria-hidden="true"></span>
          <h1 class="text-xs sm:text-sm font-semibold tracking-tight text-ink-primary">
            {t.hireMe.h1}
          </h1>
        </div>

        <h2 class="text-2xl sm:text-4xl font-bold tracking-[-0.025em] text-ink-primary leading-tight">
          {t.hireMe.heading}
        </h2>

        <p class="mt-4 text-base sm:text-lg font-semibold text-ink-primary">
          {t.hireMe.intro}
        </p>

        <p class="mt-2 text-sm sm:text-base leading-relaxed text-ink-secondary max-w-2xl">
          {t.hireMe.subcopy}
        </p>

        <div class="mt-7 grid gap-4 md:grid-cols-3">
          {t.hireMe.specialties.map((item, idx) => (
            <article class="rounded-xl border border-line/80 bg-page/55 dark:bg-subtle/35 p-5 flex flex-col">
              <div class="mb-3.5 flex h-9 w-9 items-center justify-center rounded-lg bg-accent-secondary/45 dark:bg-accent/25 text-ink-primary">
                {idx === 0 && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                )}
                {idx === 1 && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect width="16" height="16" x="4" y="4" rx="2" />
                    <rect width="6" height="6" x="9" y="9" rx="1" />
                    <path d="M15 2v2" />
                    <path d="M15 20v2" />
                    <path d="M2 15h2" />
                    <path d="M2 9h2" />
                    <path d="M20 15h2" />
                    <path d="M20 9h2" />
                    <path d="M9 2v2" />
                    <path d="M9 20v2" />
                  </svg>
                )}
                {idx === 2 && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect width="18" height="18" x="3" y="3" rx="2" />
                    <path d="M3 9h18" />
                    <path d="M9 21V9" />
                  </svg>
                )}
              </div>
              <h3 class="text-[15px] font-bold leading-snug text-ink-primary">
                {item.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-secondary">
                {item.description}
              </p>
            </article>
          ))}
        </div>
      </div>

      <!-- Direct Contact Dock -->
      <div class="border-t border-line/80 bg-subtle/40 px-6 py-6 sm:px-9 sm:py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-ink-primary">
            {t.hireMe.ctaHeading}
          </h3>
          <p class="mt-1.5 text-sm sm:text-base font-medium text-ink-secondary">
            <a
              href={`mailto:${DEVELOPER_EMAIL}`}
              class="text-ink-primary font-semibold underline decoration-accent underline-offset-4 hover:text-accent-strong transition-studio"
            >
              {t.hireMe.emailLabel}
            </a>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <button
            type="button"
            id="copy-email-btn"
            data-email={DEVELOPER_EMAIL}
            data-default-label={t.hireMe.copyButtonLabel}
            data-copied-label={t.hireMe.copiedLabel}
            class="btn-primary inline-flex min-h-[46px] items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
            </svg>
            <span id="copy-email-text">{t.hireMe.copyButtonLabel}</span>
          </button>

          <a
            href={`mailto:${DEVELOPER_EMAIL}`}
            class="inline-flex min-h-[46px] items-center gap-2 rounded-xl border border-line bg-card px-5 py-2.5 text-sm font-semibold text-ink-primary hover:bg-subtle transition-studio"
          >
            <svg class="h-4 w-4 text-accent-strong shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
            <span>{t.hireMe.emailButtonLabel}</span>
          </a>
        </div>

        <span id="copy-email-status" role="status" aria-live="polite" class="sr-only"></span>
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById('copy-email-btn');
      var textEl = document.getElementById('copy-email-text');
      var statusEl = document.getElementById('copy-email-status');
      if (!btn || !textEl) return;

      var timer = null;
      btn.addEventListener('click', function () {
        var email = btn.getAttribute('data-email') || 'kisharadilshan007@gmail.com';
        var defaultLabel = btn.getAttribute('data-default-label') || 'Copy Email';
        var copiedLabel = btn.getAttribute('data-copied-label') || 'Copied!';

        function showCopied() {
          textEl.textContent = copiedLabel;
          if (statusEl) statusEl.textContent = copiedLabel + ' ' + email;
          if (timer) clearTimeout(timer);
          timer = setTimeout(function () {
            textEl.textContent = defaultLabel;
          }, 2400);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(email).then(showCopied).catch(function () {
            fallbackCopy(email, showCopied);
          });
        } else {
          fallbackCopy(email, showCopied);
        }
      });

      function fallbackCopy(val, cb) {
        var ta = document.createElement('textarea');
        ta.value = val;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try {
          var cmd = 'exec' + 'Command';
          if (typeof document[cmd] === 'function') {
            document[cmd]('copy');
            cb();
          }
        } catch (_) {}
        document.body.removeChild(ta);
      }
    })();
  </script>
</BaseLayout>
