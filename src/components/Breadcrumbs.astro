---
import { getLocalizedPath, type LocaleCode } from '../i18n/config';

interface Props {
  lang: LocaleCode;
  homeLabel: string;
  currentLabel: string;
  navAriaLabel: string;
}

const { lang, homeLabel, currentLabel, navAriaLabel } = Astro.props;
const homeHref = getLocalizedPath(lang, 'home');
---

<nav aria-label={navAriaLabel} class="mb-6">
  <ol class="flex flex-wrap items-center gap-2 text-sm font-medium text-ink-secondary">
    <li>
      <a
        href={homeHref}
        class="inline-flex items-center gap-1.5 rounded-md px-1.5 py-1 hover:text-ink-primary hover:underline underline-offset-4 transition-studio"
      >
        <svg
          class="w-4 h-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5" />
        </svg>
        <span>{homeLabel}</span>
      </a>
    </li>
    <li aria-hidden="true" class="select-none text-ink-secondary/70">/</li>
    <li aria-current="page" class="text-ink-primary font-semibold px-1 py-1">
      {currentLabel}
    </li>
  </ol>
</nav>
