---
import HowToUsePage from '../../components/HowToUsePage.astro';
import { NON_DEFAULT_LOCALES, type LocaleCode } from '../../i18n/config';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((lang) => ({
    params: { lang },
    props: { lang },
  }));
}

interface Props {
  lang: LocaleCode;
}

const { lang } = Astro.props;
---

<HowToUsePage lang={lang} />
